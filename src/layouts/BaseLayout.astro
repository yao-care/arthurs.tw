---
import "../styles/variables.css";
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { organizationSchema, websiteSchema } from "../lib/seo";
import { SITE } from "../lib/site";

interface Props {
  title: string;
  description?: string;
  schemas?: object[];
  ogType?: string;
  robots?: string;
}
const { title, description = SITE.tagline, schemas = [], ogType = "website", robots = "index, follow, max-image-preview:large" } = Astro.props;
const fullTitle = title === SITE.name ? title : `${title}｜${SITE.name}`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin).href;
const ogImage = new URL("/og.png", Astro.site ?? Astro.url.origin).href;
const baseSchemas = [organizationSchema(), websiteSchema(), ...schemas];
const gaId = import.meta.env.PUBLIC_GA_ID ?? SITE.gaId;
---

<!doctype html>
<html lang="zh-Hant-TW">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="robots" content={robots} />
    {/* Open Graph */}
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content="zh_TW" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={SITE.name} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="theme-color" content={SITE.themeColor} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {baseSchemas.map((s) => (
      <script type="application/ld+json" set:html={JSON.stringify(s)} />
    ))}
    {gaId && (
      <script is:inline define:vars={{ gaId, lineUrl: SITE.line, siteHost: new URL(SITE.url).hostname }}>
        // GA4 只在正式網域、且不是內部瀏覽時才載入（2026-09-07 補）。
        // 在此之前 gtag 無條件輸出：pnpm dev／pnpm preview 開的 localhost 頁面照打 GA4，
        // 老闆自己巡站也照算，全期 139 個 session 有 128 個是 direct，KPI 讀出來全是我們自己。
        // 內部標記：任一頁網址帶 ?internal=1 就在這台瀏覽器記住、之後全站都不送；?internal=0 解除。
        // 判斷放在瀏覽器端而不是 GA4 後台的資料篩選器，是因為篩選器要另外到後台建、建了還得從「測試」切到「啟用」，
        // 少一步就等於沒做；這裡直接不送，沒有第二步。
        var internal = false;
        try {
          var flag = new URLSearchParams(location.search).get('internal');
          if (flag === '1') localStorage.setItem('arthurs_internal', '1');
          else if (flag === '0') localStorage.removeItem('arthurs_internal');
          internal = localStorage.getItem('arthurs_internal') === '1';
        } catch (e) {}
        var onSite = location.hostname === siteHost;

        window.dataLayer = window.dataLayer || [];
        function gtag(){ dataLayer.push(arguments); }
        // define:vars 會把這段包進 IIFE，gtag 因此只是區域函式。
        // 掛回 window 才能讓各頁自己的 script（如 /ai-check/）送事件；不載入時也掛，事件只進佇列不會出去。
        window.gtag = gtag;

        if (onSite && !internal) {
          var tag = document.createElement('script');
          tag.async = true;
          tag.src = 'https://www.googletagmanager.com/gtag/js?id=' + encodeURIComponent(gaId);
          document.head.appendChild(tag);
          gtag('js', new Date());
          gtag('config', gaId);

          // 轉換量測（2026-07-30 補）。在此之前全站只有 gtag('config')，GA4 只看得到
          // page_view 這類自動事件，量不到「有人真的來聯絡」。買任何流量之前得先有這一段，
          // 否則只知道來了幾個人，不知道發生什麼事。
          // 三個事件對應三個真實動作：按 LINE、按 Email、表單送出成功。
          // 送出成功以到達 /website-check/thank-you/ 為準；表單頁先寫入一次性標記，
          // 避免訪客直接重開感謝頁時重複計算轉換。
          // 事件名 generate_lead 沿用 GA4 建議名稱，後台可直接標為關鍵事件。
          document.addEventListener('click', function (e) {
            var a = e.target && e.target.closest ? e.target.closest('a[href]') : null;
            if (!a) return;
            var href = a.getAttribute('href') || '';
            if (lineUrl && href.indexOf(lineUrl) === 0) {
              gtag('event', 'line_click', { link_location: location.pathname, link_text: (a.textContent || '').trim().slice(0, 60) });
            } else if (href.indexOf('mailto:') === 0) {
              gtag('event', 'email_click', { link_location: location.pathname });
            }
          });

          if (location.pathname.indexOf('/website-check/thank-you') === 0 && sessionStorage.getItem('arthurs_lead_submitted') === '1') {
            gtag('event', 'generate_lead', { form_name: 'website_check' });
            sessionStorage.removeItem('arthurs_lead_submitted');
          }
        }
      </script>
    )}
  </head>
  <body class="has-mobile-cta">
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
