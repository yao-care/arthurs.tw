---
import "../styles/variables.css";
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { organizationSchema, websiteSchema } from "../lib/seo";
import { SITE } from "../lib/site";

interface Props {
  title: string;
  description?: string;
  schemas?: object[];
  ogType?: string;
  robots?: string;
}
const { title, description = SITE.tagline, schemas = [], ogType = "website", robots = "index, follow, max-image-preview:large" } = Astro.props;
const fullTitle = title === SITE.name ? title : `${title}｜${SITE.name}`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin).href;
const ogImage = new URL("/og.png", Astro.site ?? Astro.url.origin).href;
const baseSchemas = [organizationSchema(), websiteSchema(), ...schemas];
const gaId = import.meta.env.PUBLIC_GA_ID ?? SITE.gaId;
---

<!doctype html>
<html lang="zh-Hant-TW">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="robots" content={robots} />
    {/* Open Graph */}
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content="zh_TW" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={SITE.name} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="theme-color" content={SITE.themeColor} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {baseSchemas.map((s) => (
      <script type="application/ld+json" set:html={JSON.stringify(s)} />
    ))}
    {gaId && (
      <>
        <script async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`}></script>
        <script is:inline define:vars={{ gaId, lineUrl: SITE.line }}>
          window.dataLayer = window.dataLayer || [];
          function gtag(){ dataLayer.push(arguments); }
          // define:vars 會把這段包進 IIFE，gtag 因此只是區域函式。
          // 掛回 window 才能讓各頁自己的 script（如 /ai-check/）送事件。
          window.gtag = gtag;
          gtag('js', new Date());
          gtag('config', gaId);

          // 轉換量測（2026-07-30 補）。在此之前全站只有 gtag('config')，GA4 只看得到
          // page_view 這類自動事件，量不到「有人真的來聯絡」。買任何流量之前得先有這一段，
          // 否則只知道來了幾個人，不知道發生什麼事。
          // 三個事件對應三個真實動作：按 LINE、按 Email、表單送出成功。
          // 送出成功以到達 /website-check/thank-you/ 為準；表單頁先寫入一次性標記，
          // 避免訪客直接重開感謝頁時重複計算轉換。
          // 事件名 generate_lead 沿用 GA4 建議名稱，後台可直接標為關鍵事件。
          document.addEventListener('click', function (e) {
            var a = e.target && e.target.closest ? e.target.closest('a[href]') : null;
            if (!a) return;
            var href = a.getAttribute('href') || '';
            if (lineUrl && href.indexOf(lineUrl) === 0) {
              gtag('event', 'line_click', { link_location: location.pathname, link_text: (a.textContent || '').trim().slice(0, 60) });
            } else if (href.indexOf('mailto:') === 0) {
              gtag('event', 'email_click', { link_location: location.pathname });
            }
          });

          if (location.pathname.indexOf('/website-check/thank-you') === 0 && sessionStorage.getItem('arthurs_lead_submitted') === '1') {
            gtag('event', 'generate_lead', { form_name: 'website_check' });
            sessionStorage.removeItem('arthurs_lead_submitted');
          }
        </script>
      </>
    )}
  </head>
  <body class="has-mobile-cta">
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
