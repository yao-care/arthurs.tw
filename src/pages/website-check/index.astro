---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { SITE } from "../../lib/site";
import { breadcrumbSchema } from "../../lib/seo";
const schemas = [breadcrumbSchema([{ name: "首頁", path: "/" }, { name: "網站健檢", path: "/website-check/" }])];
const checks = [
  "網站內容是否過時", "產品及服務是否清楚", "Google 是否容易理解網站",
  "AI 是否容易理解公司業務", "網站是否適合持續更新", "是否具備搜尋及流量資料",
  "網站是否掌握在你自己手中", "是否適合這個顧問服務",
];
// 自我健檢清單：每一項都是不用工具、不用懂技術，自己一兩分鐘能做完的檢查。
const selfChecks = [
  {
    t: "拿手機搜「你的服務＋地區」",
    d: "比如你在台中做水電，就搜「台中 水電」。翻到第 2 頁還沒看到自己，代表用這種方式找你的客人，看不到你。",
  },
  {
    t: "問 ChatGPT：「某某公司是做什麼的？」（填你的公司名）",
    d: "答不出來，或講得跟事實有出入，代表 AI 目前讀不到或讀不懂你的網站。現在已經有人直接問 AI 找廠商，這一塊你是缺席的。",
  },
  {
    t: "在 Google 搜尋框輸入 site: 加你的網址",
    d: "中間不要空格，長得像 site:你的網址.com。這是在問 Google：你手上有我網站的哪幾頁。列出來只有一兩頁，或明顯比實際頁數少一截，代表 Google 沒把你的網站收齊，沒收進去的頁不會出現在任何搜尋結果裡。",
  },
  {
    t: "打開自己的網站，看最新消息停在哪一年",
    d: "最新一則的日期停在幾年前，訪客第一個念頭常常是：這間公司還有在做嗎。",
  },
  {
    t: "用手機開自己的網站逛一圈",
    d: "字小到要用手指放大、按鈕點不準、圖片超出畫面，中一個就算有問題。現在多數人是用手機看網站的。",
  },
  {
    t: "在手機上點網站的電話號碼",
    d: "點下去應該直接跳出撥號畫面。沒反應的話，客人得自己抄號碼再輸入一次；急著找人的客人不一定有這個耐心。",
  },
  {
    t: "Google 搜自己的公司名稱",
    d: "看排最前面的是不是你自己的網站。如果別人平台上的頁面（地圖、黃頁、臉書）排在你前面，客人第一眼看到的資訊放在別人手上，新不新、對不對，不見得由你決定。粉專經營得再好，這件事社群平台也代勞不了，兩者的差別可以看<a href=\"/articles/website-or-social-media/\">這篇</a>。",
  },
  {
    t: "隨便抽一頁，核對價格、營業時間、地址",
    d: "跟現在的狀況對不上就是問題。過期的資訊會讓客人照著打電話、照著跑一趟，然後撲空。",
  },
  {
    t: "首頁 10 秒測試",
    d: "找一個沒看過你網站的朋友，給他 10 秒看首頁，然後問他你們是做什麼的。他講不出來，代表首頁寫的是你想講的話，不是客人要找的答案。",
  },
  {
    t: "想改網站上的一行字，你知道要找誰嗎？",
    d: "回想一下上次改網站等了多久。要翻半天才找得到當初做網站的人，或想不起帳號在誰手上，代表網站不在你自己手中。很多網站放到過期，原因就在這裡。",
  },
];
---
<BaseLayout title="網站健檢" description="附 10 項不用懂技術、自己就能做的網站檢查：搜得到嗎、AI 認得你嗎、手機上看正常嗎。查完把網址傳給我，我再幫你看深一層。填表送出或加 LINE 都可以。" schemas={schemas}>
  <section class="page-head">
    <div class="container">
      <p class="breadcrumb"><a href="/">首頁</a> ／ 網站健檢</p>
      <h1>把現在的網站網址傳給我，我先幫你看看問題在哪裡。</h1>
      <p class="lede">先不用決定要不要重做網站。看完再決定也不遲。</p>
    </div>
  </section>
  <section class="section">
    <div class="container">
      <div class="grid grid-2">
        <div>
          <h2 style="font-size: var(--text-lg);">我們會先看這幾件事</h2>
          <ul class="check-list" style="margin-top: 1rem;">{checks.map((c) => <li>{c}</li>)}</ul>
          <p class="muted" style="margin-top: 1.5rem;">
            收到你的網站網址後，我們會先看內容新不新、Google 搜不搜得到、AI 讀不讀得懂、後續好不好維護，抓出現在最值得改善的地方。
          </p>
          <div class="card" style="margin-top: 1.5rem;">
            <h3 style="font-size: var(--text-lg); margin-top: 0;">不想填表？直接聯絡也可以</h3>
            <p class="muted" style="margin-top: 0.5rem;">把公司名稱與現在的網站網址傳給我就好。</p>
            <p class="btn-row" style="margin-top: 0.75rem;">
              {SITE.line && <a href={SITE.line} class="btn btn-primary" target="_blank" rel="noopener">加 LINE 傳網址</a>}
              {SITE.email && <a href={`mailto:${SITE.email}`} class="btn btn-secondary">寄 Email</a>}
            </p>
          </div>
        </div>
        <div class="card">
          <form id="check-form">
            <input type="text" name="_honey" style="display:none" tabindex="-1" autocomplete="off" />
            <div class="field"><label for="company">公司名稱</label><input id="company" name="公司名稱" required /></div>
            <div class="field"><label for="contact">聯絡人</label><input id="contact" name="聯絡人" required /></div>
            <div class="field"><label for="phone">聯絡方式（電話或 Email）</label><input id="phone" name="聯絡方式" required /></div>
            <div class="field"><label for="url">現有網站網址</label><input id="url" name="現有網站網址" placeholder="https://" /></div>
            <div class="field"><label for="industry">公司產業</label><input id="industry" name="公司產業" /></div>
            <div class="field"><label for="problem">最想解決的問題</label><textarea id="problem" name="最想解決的問題"></textarea></div>
            <div class="field">
              <label for="ai">是否已有 ChatGPT 或其他 AI 訂閱</label>
              <select id="ai" name="是否已有AI訂閱"><option value="">請選擇</option><option>已有</option><option>沒有</option><option>不確定</option></select>
            </div>
            <div class="field"><label for="note">其他補充</label><textarea id="note" name="其他補充"></textarea></div>
            <button id="submit-btn" type="submit" class="btn btn-primary" style="width: 100%;">送出網站網址</button>
            <p id="form-note" class="fs-xs muted" style="margin-top: 0.75rem;"></p>
          </form>
        </div>
      </div>
    </div>
  </section>
  <section class="section section-soft" id="self-check">
    <div class="container">
      <span class="eyebrow">自己先查</span>
      <h2 class="section-title">網站健檢清單：這幾件事你自己就能查</h2>
      <p class="lede">不用工具，不用懂技術，每件花一兩分鐘。查完你大概就知道自己的網站卡在哪。</p>
      <ol class="flow" style="margin-top: 2rem;">
        {selfChecks.map((c) => (
          <li>
            <strong>{c.t}</strong>
            <p class="muted" style="margin: 0.35rem 0 0;">{c.d}</p>
          </li>
        ))}
      </ol>
      <p class="muted" style="margin-top: 1.5rem; max-width: var(--maxw-prose);">
        先說清楚：這些檢查看的是症狀，不是原因。中了幾項不代表非重做網站不可，也沒有改了就保證排名這回事。但查完如果有中，把網址傳給我，我幫你看深一層：問題出在內容、結構，還是根本沒被 Google 和 AI 讀到。已經用檢測工具測過、拿到一個分數的話，那個分數實際在算什麼、哪些真的該修，<a href="/articles/what-seo-score-tools-really-tell-you/">這篇說明</a>。還在猶豫要花時間做 SEO、還是乾脆下廣告比較快，<a href="/articles/seo-or-ads/">這篇</a>講兩者的差別跟怎麼選。
      </p>
      <p class="btn-row" style="margin-top: 1rem;">
        <a href="#check-form" class="btn btn-primary">把網址傳給我</a>
        {SITE.line && <a href={SITE.line} class="btn btn-secondary" target="_blank" rel="noopener">用 LINE 傳也可以</a>}
      </p>
    </div>
  </section>
  <script is:inline define:vars={{ email: SITE.email, line: SITE.line }}>
    const form = document.getElementById("check-form");
    const note = document.getElementById("form-note");
    const btn = document.getElementById("submit-btn");
    const endpoint = "https://formsubmit.co/ajax/" + email;
    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      if (form._honey.value) return;
      btn.disabled = true;
      note.textContent = "送出中…";
      const data = Object.fromEntries(new FormData(form));
      data._subject = "網站健檢申請：" + (data["公司名稱"] || "");
      data._template = "table";
      delete data._honey;
      try {
        const r = await fetch(endpoint, {
          method: "POST",
          headers: { "Content-Type": "application/json", Accept: "application/json" },
          body: JSON.stringify(data),
        });
        if (r.ok) {
          window.location.href = "/website-check/thank-you/";
        } else {
          throw new Error("bad status");
        }
      } catch (err) {
        btn.disabled = false;
        note.textContent = "送出遇到問題，麻煩改用 LINE（" + line + "）或 Email（" + email + "）把網址傳給我，我會盡快回覆。";
      }
    });
  </script>
</BaseLayout>
