---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Cta from "../../components/Cta.astro";
import { CASES } from "../../lib/site";
import { breadcrumbSchema } from "../../lib/seo";
import { getCollection } from "astro:content";
const schemas = [breadcrumbSchema([{ name: "首頁", path: "/" }, { name: "網站案例", path: "/cases/" }])];
// 有寫內頁的案例才顯示「這個站怎麼做的」連結，避免連到不存在的頁。
const detailed = new Set((await getCollection("cases")).map((e) => e.id));
---
<BaseLayout title="網站案例" description="這裡放的都是已經上線的網站，點進去就是實站，不是示意圖。做過運動賽事、醫療協會、台中在地服務、健康工具、教育協會。你現在看的這個網站也算一個。" schemas={schemas}>
  <section class="page-head">
    <div class="container">
      <p class="breadcrumb"><a href="/">首頁</a> ／ 網站案例</p>
      <h1>網站案例</h1>
      <p class="lede">這些都是已經做出來、上線中的網站。點進去就是實站，不是示意圖。你現在看的這個網站，也是其中之一。</p>
    </div>
  </section>
  <section class="section">
    <div class="container">
      <div class="grid grid-3">
        {CASES.map((c) => (
          <div class="card">
            <p style="margin: 0 0 0.5rem;">
              <span class="badge">{c.industry}</span>
              {c.self && <span class="badge badge-plan" style="margin-left: 0.4rem;">本站</span>}
            </p>
            <h3 style="font-size: var(--text-lg);">{c.name}</h3>
            <p class="muted">{c.desc}</p>
            <p class="fs-xs" style="margin: 0 0 0.6rem;">
              <a href={c.deep ?? c.url} target="_blank" rel="noopener">{c.url.replace(/^https?:\/\//, "").replace(/\/$/, "")} →</a>
            </p>
            {detailed.has(c.slug) && <p class="fs-sm" style="margin: 0;"><a href={`/cases/${c.slug}/`}>這個站怎麼做的</a></p>}
          </div>
        ))}
      </div>
    </div>
  </section>
  <section class="section section-soft">
    <div class="container">
      <h2 class="section-title">這些網站有什麼共同點</h2>
      <div class="grid grid-3" style="margin-top: 1.5rem;">
        <div class="card">
          <h3 style="font-size: var(--text-lg);">不寫口號</h3>
          <p class="muted">「品質第一、專業可靠」這種句子，客戶看完還是不知道你會什麼。這些網站寫的是做哪些項目、範圍到哪、有什麼限制。</p>
        </div>
        <div class="card">
          <h3 style="font-size: var(--text-lg);">數字點得回出處</h3>
          <p class="muted">講到成效、引到研究，後面就附得出來源。查不到出處的，我們寧可不寫。</p>
        </div>
        <div class="card">
          <h3 style="font-size: var(--text-lg);">上線之後還在長</h3>
          <p class="muted">有的每天更新，有的一個月幾篇。差別不大，重點是它沒有停在交件那天。</p>
        </div>
      </div>
    </div>
  </section>
  <section class="section">
    <div class="container prose stack">
      <h2>你可以自己點進去驗證</h2>
      <p>上面每張卡片點下去都是實站。我自己看別人的網站，會先看這幾個地方：</p>
      <ul>
        <li>翻到最舊的那篇內容，看更新日期。停在幾年前的網站，客戶和 Google 都看得出來。</li>
        <li>挑一項服務，看它有沒有寫清楚做什麼、限制在哪。只有口號的網站，<a href="/articles/chatgpt-doesnt-know-my-company/">AI 讀完也講不出這家在幹嘛</a>。</li>
        <li>拿站上的說法去 Google 搜一次，看查不查得到出處。</li>
      </ul>
      <h2>在地老店也吃得到這一套</h2>
      <p>
        <a href="https://www.olderkkk.com/" target="_blank" rel="noopener">鄭骨館體雕中心</a>在台中西屯，做的是整骨和運動矯正這種老師傅的手藝。不是大品牌，也沒有行銷預算。
      </p>
      <p>
        這種店最吃虧的地方在於，手藝好不好只有老客戶知道。新客人拿手機搜，或直接問 AI，這家就不在名單裡。後來把矯正加肌力那套方法一步一步寫清楚，衛教文章也持續在更新，AI 被問到這一類服務時就會主動把它點出來。你可以到<a href="/ai-check/">AI 認得你嗎</a>那頁自己按一次看。
      </p>
      <p>
        中部像這樣的工廠和店家很多。東西做了幾十年，網路上卻幾乎查不到。要補的東西其實很明確，就是把你實際在做的事，用客人會講的話寫出來。<a href="/qa/which-areas-do-you-serve/">台中和中部可以約見面</a>。
      </p>
      <p class="muted">其他案例還在整理。之後每個案例會補上一頁，寫這家原本卡在哪裡、後來怎麼做的。</p>
      <p><Cta /></p>
    </div>
  </section>
</BaseLayout>
