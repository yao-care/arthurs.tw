---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Cta from "../../components/Cta.astro";
import { getCollection } from "astro:content";
import { breadcrumbSchema } from "../../lib/seo";

const updates = (await getCollection("updates")).sort((a, b) => (a.data.date < b.data.date ? 1 : -1));
const badge = { published: ["badge-ok", "已發布"], wip: ["badge-wip", "進行中"], planned: ["badge-plan", "規劃中"] };
const schemas = [breadcrumbSchema([{ name: "首頁", path: "/" }, { name: "網站更新紀錄", path: "/updates/" }])];
---
<BaseLayout title="網站更新紀錄" description="這個網站每一次改動的公開帳本：發現什麼問題、根據哪來的資料、改了什麼、AI 幫了什麼、人工確認了什麼。你要看我怎麼做事，看這頁比看我怎麼講更準。" schemas={schemas}>
  <section class="page-head">
    <div class="container">
      <p class="breadcrumb"><a href="/">首頁</a> ／ 網站更新紀錄</p>
      <h1>網站更新紀錄</h1>
      <p class="lede">這頁是我做事的帳本。每一次改動都記在這裡：發現什麼問題、根據哪來的資料、改了什麼、AI 做了什麼、人工確認了什麼。</p>
      <p>一個人會不會把你的網站顧好，看他自己的網站就知道。數字沒起色的時候我會怎麼查、怎麼處理，寫在<a href="/qa/can-google-ranking-be-guaranteed/">這一題</a>和<a href="/articles/what-i-do-when-numbers-dont-move/">這篇文章</a>裡。下面這些紀錄，就是我照那套做的過程。</p>
    </div>
  </section>
  <section class="section">
    <div class="container prose">
      <div class="stack" style="--space: 1.5rem;">
        {updates.map((u) => {
          const [cls, label] = badge[u.data.status];
          const rows = [
            ["更新頁面", u.data.page], ["更新原因", u.data.reason], ["發現來源", u.data.source],
            ["AI 協助", u.data.aiHelp], ["人工確認", u.data.humanReview], ["觀察目標", u.data.watch],
          ].filter(([, v]) => v);
          return (
            <article class="card" style="margin-bottom: 1.5rem;">
              <p style="margin: 0 0 0.4rem;"><span class={`badge ${cls}`}>{label}</span> <span class="fs-xs muted">{u.data.date}</span></p>
              <h2 style="font-size: var(--text-lg); margin: 0 0 0.75rem;">{u.data.title}</h2>
              <dl class="deflist">
                {rows.map(([k, v]) => (<div><dt>{k}</dt><dd>{v}</dd></div>))}
              </dl>
            </article>
          );
        })}
      </div>
      <p style="margin-top: 1rem;"><Cta /></p>
    </div>
  </section>
</BaseLayout>
