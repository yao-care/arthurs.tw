---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Cta from "../../components/Cta.astro";
import { breadcrumbSchema } from "../../lib/seo";

const schemas = [breadcrumbSchema([
  { name: "首頁", path: "/" },
  { name: "AI 認得你嗎", path: "/ai-check/" },
])];

// 讓訪客在「自己的」ChatGPT 上問，我們不代答、也沒有作假空間。
//
// 2026-07-25 定案（別再改回去）：這頁不靠 OpenAI 的未公開參數。按鈕按下去同時做兩件事，
// 問題進剪貼簿、ChatGPT 開新分頁；q= 有效就順便幫他填好，失效就貼上。問題原文也直接
// 印在頁面上（.ask-q），剪貼簿被瀏覽器擋掉還選得到。三條路任一條活著，這頁就不會變死路。
// hints=search 已拿掉：老闆實測「送出後有問題」時它有嫌疑，而且我們本來就不需要強制搜尋模式。
const ask = (q: string) => `https://chatgpt.com/?q=${encodeURIComponent(q)}`;

// 示範標的＝鄭骨館體雕中心：實測（2026-07-24）唯一「指名問講得出、
// 買家問法也被列第一名」的案例站。換標的前務必重新實測，別憑印象。
const DEMO = {
  name: "鄭骨館體雕中心",
  url: "https://www.olderkkk.com/",
  buyerAsk: "推薦幾間台中西屯區的整骨、運動矯正體雕工作室，並說明它們的特色。",
  nameAsk: "介紹一下「鄭骨館體雕中心」這家店，它做什麼、有什麼特色？",
};

const HOWTO = "按下去，問題會複製到你的剪貼簿，ChatGPT 開在新分頁。問題已經填好就直接按 Enter，沒填就貼上再按 Enter。";
---
<BaseLayout
  title="AI 認得你的公司嗎"
  description="現在的人直接問 ChatGPT 找廠商。這頁讓你自己動手問：先看 AI 怎麼主動推薦一家台中的整骨工作室，再輸入你的公司名，看它怎麼講你。"
  schemas={schemas}
>
  <section class="page-head">
    <div class="container">
      <p class="breadcrumb"><a href="/">首頁</a> ／ AI 認得你嗎</p>
      <h1>現在的人問 AI 找廠商。<br />它推薦得出你嗎？</h1>
      <p class="lede">
        別聽我說，自己問。下面的問題都幫你寫好了，按一下就複製並開啟你自己的 ChatGPT，答案是它當場給你的。
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <span class="eyebrow">先看做對的樣子</span>
      <h2 class="section-title">一家台中的整骨工作室，AI 主動把它排第一。</h2>
      <div class="card" style="margin-top: 2rem;">
        <p>
          <a href={DEMO.url} rel="noopener">{DEMO.name}</a> 是一家在台中西屯的小店，不是什麼大品牌。
          但當有人請 AI 推薦這一類服務，它會被主動點名，還附得出地址、時段與特色。
        </p>
        <p class="fs-xs muted" style="margin-top: 1rem;">{HOWTO}</p>

        <div class="ask-item" style="margin-top: 1.5rem;">
          <p class="ask-label">客戶會這樣問</p>
          <p class="ask-q">{DEMO.buyerAsk}</p>
          <a href={ask(DEMO.buyerAsk)} data-copy={DEMO.buyerAsk} class="btn btn-primary" target="_blank" rel="noopener">
            複製問題並打開 ChatGPT
          </a>
        </div>
        <div class="ask-item">
          <p class="ask-label">指名問這家店</p>
          <p class="ask-q">{DEMO.nameAsk}</p>
          <a href={ask(DEMO.nameAsk)} data-copy={DEMO.nameAsk} class="btn btn-secondary" target="_blank" rel="noopener">
            複製問題並打開 ChatGPT
          </a>
        </div>

        <p class="fs-xs muted" style="margin-top: 1.5rem;">
          AI 的回答每次不完全一樣，也可能隨時改變，這是它的本質。這裡不是保證誰一定被推薦，是讓你看見「被 AI 講得出來」長什麼樣子。
        </p>
      </div>
    </div>
  </section>

  <section class="section section-soft">
    <div class="container">
      <span class="eyebrow">換你了</span>
      <h2 class="section-title">輸入你的公司名，去問問看它認不認得你。</h2>
      <p class="prose" style="margin-top: 1rem;">
        打上你的公司全名（有地區、行業更準），下面兩個問題會跟著改。我們看不到你打了什麼，也不會留下紀錄。
      </p>
      <div class="card" style="margin-top: 2rem;">
        <div class="field">
          <label for="company">你的公司名稱</label>
          <input id="company" name="company" type="text" autocomplete="organization"
                 placeholder="例如：某某企業有限公司（台中，金屬加工）" />
        </div>
        <p class="fs-xs muted">{HOWTO}</p>

        <div class="ask-item" style="margin-top: 1.5rem;">
          <p class="ask-label">它認得你嗎</p>
          <p class="ask-q" id="q-name">介紹一下這家公司</p>
          <a id="ask-name" href={ask("介紹一下這家公司")} data-copy="介紹一下這家公司" class="btn btn-primary" target="_blank" rel="noopener">
            複製問題並打開 ChatGPT
          </a>
        </div>
        <div class="ask-item">
          <p class="ask-label">客戶沒指名時，它推薦誰</p>
          <p class="ask-q" id="q-buyer">推薦幾家廠商</p>
          <a id="ask-buyer" href={ask("推薦幾家廠商")} data-copy="推薦幾家廠商" class="btn btn-secondary" target="_blank" rel="noopener">
            複製問題並打開 ChatGPT
          </a>
        </div>

        <p class="fs-xs muted" style="margin-top: 1.5rem;">
          沒填也能按，只是問得不準。第二題是重點：客戶不會指名找你，他們是問「推薦一家做這行的」。
        </p>
      </div>
    </div>
  </section>

  <section class="section section-deep">
    <div class="container prose mx-auto">
      <span class="eyebrow">看到結果之後</span>
      <h2 class="section-title">如果它講不出你，或推薦了別人。</h2>
      <p style="margin-top: 1.5rem;">
        那不是你的錯，也不是無解。AI 講得出一家公司，靠的是網路上關於它的資料夠完整、夠新、講得夠清楚；被推薦給不認識你的人，還要看有沒有別人談過你。這兩件事都能一步一步補。
      </p>
      <p style="margin-top: 1rem;">
        我不會跟你保證做完就一定被 AI 推薦，沒有人能保證那件事。我能做的是把你該有的資料做齊、做對，讓你不會因為「網路上根本沒有你」而被漏掉。
      </p>
      <p style="margin-top: 1rem;">
        把你現在的網站網址傳給我，我先看看問題在哪。
      </p>
      <p class="btn-row" style="margin-top: 2rem;">
        <Cta />
        <a href="/how-it-works/" class="btn btn-secondary">看 AI 怎麼做</a>
      </p>
    </div>
  </section>
</BaseLayout>

<script>
  // 純前端：訪客打的公司名不離開這台瀏覽器，我們不收、不存。
  const input = document.getElementById("company") as HTMLInputElement | null;
  const askName = document.getElementById("ask-name") as HTMLAnchorElement | null;
  const askBuyer = document.getElementById("ask-buyer") as HTMLAnchorElement | null;
  const qName = document.getElementById("q-name");
  const qBuyer = document.getElementById("q-buyer");

  const link = (q: string) => `https://chatgpt.com/?q=${encodeURIComponent(q)}`;

  if (input && askName && askBuyer && qName && qBuyer) {
    const sync = () => {
      const name = input.value.trim();
      const nameQ = name
        ? `介紹一下「${name}」這家公司，它做什麼、有什麼特色？如果你不確定或找不到資料，請直接說不知道，不要猜。`
        : "介紹一下這家公司";
      const buyerQ = name
        ? `我想找廠商。請推薦幾家同「${name}」做同一類服務、同一個地區的公司，並說明推薦理由。`
        : "推薦幾家廠商";
      qName.textContent = nameQ;
      qBuyer.textContent = buyerQ;
      askName.href = link(nameQ);
      askBuyer.href = link(buyerQ);
      askName.dataset.copy = nameQ;
      askBuyer.dataset.copy = buyerQ;
    };
    input.addEventListener("input", sync);
    sync();
  }

  // 按鈕同時複製問題並開 ChatGPT。不攔截導向：就算複製失敗，分頁照開，問題原文也還印在頁面上。
  document.addEventListener("click", (e) => {
    const target = e.target as HTMLElement | null;
    const btn = target?.closest("[data-copy]") as HTMLAnchorElement | null;
    const text = btn?.dataset.copy;
    if (!btn || !text || !navigator.clipboard) return;
    navigator.clipboard.writeText(text).then(
      () => {
        const label = btn.textContent;
        btn.textContent = "問題已複製，貼上按 Enter";
        setTimeout(() => { btn.textContent = label; }, 4000);
      },
      () => {}
    );
  });
</script>
